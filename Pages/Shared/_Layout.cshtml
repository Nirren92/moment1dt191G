<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - moment1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/moment1.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="d-flex align-items-center" style="height: 150px;padding: 0 20px;">
        <img src="~/logo.png" style="height: 60px;" alt="logo">
        <div class="flex-grow-1 text-center">
            <h1 class="mb-0">Niklas Sida</h1>
        </div>
        <div>
            <p><strong>Dagens datum: <br>@DateTime.Now.ToString("yyyy-MM-dd")</strong></p>
        </div>
    </header>


    <div class="container-fluid" >
        <div class="row"> 
            <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                <div class="position-sticky pt-3" >
                    <ul class="nav flex-column mb-auto">
                        <li class="nav-item" >
                            <a class="nav-link " asp-area="" asp-page="/Index">Start</a>
                        </li>
                        <li class="nav-item" >
                            <a class="nav-link " asp-area="" asp-page="/razor">Razor</a>
                        </li>
                        <li class="nav-item" >
                            <a class="nav-link " asp-area="" asp-page="/Index">Om sidan</a>
                        </li>
                    </ul>
                </div>
            </nav>
            
            <div class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>





    
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - moment1 - skapad av Niklas 
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
